.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Generated per-seed databases and audit logs.
data/seed_*/
data/scale/

# Agent output awaiting human review. Regenerated by `make drafts` and
# `make strategy`; committing it would make a proposal look like a decision.
data/drafts/

# WAL sidecars, in case a db is ever committed deliberately.
*.db-wal
*.db-shm

# NOT ignored, on purpose:
#   data/llm_cache/   committed so reruns cost nothing and CI stays free
#   data/fixtures/    recorded Razorpay responses, so tests need no network
