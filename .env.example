# Copy to .env (gitignored). Every value below is optional:
# `make test` and the default simulated executor need none of them.

# --- Razorpay, test mode only -------------------------------------------
# Dashboard -> Settings -> API Keys. Keys must start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks. Used to verify X-Razorpay-Signature
# against the RAW request body -- see rcp/ingest/webhook.py.
RAZORPAY_WEBHOOK_SECRET=

# Merchant token for the remote MCP server (rcp/execute/razorpay_mcp.py).
RAZORPAY_MCP_TOKEN=

# --- LLM ----------------------------------------------------------------
# None of this is needed to reproduce the eval. RCP_LLM=fallback is the
# default: deterministic, offline, and data/llm_cache/ is committed.
#
# Every provider below goes through the same adapter seam
# (rcp/llm/adapter.py), so switching is one env var. Adding a vendor that
# speaks the OpenAI wire format is a row in client.OPENAI_COMPATIBLE.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

# --- Runtime ------------------------------------------------------------
RCP_SEED=42
RCP_EXECUTOR=simulated          # simulated | razorpay_mcp | razorpay_rest
# fallback | anthropic | groq | gemini | openai | together | ollama
RCP_LLM=fallback
# Pin a model id -- the per-vendor defaults drift faster than anything else.
# RCP_LLM_MODEL=claude-opus-5
